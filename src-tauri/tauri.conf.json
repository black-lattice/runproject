{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunProject",
  "version": "0.1.4",
  "identifier": "com.changzhenhua.runproject",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RunProject",
        "width": 1300,
        "height": 800,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "tray-panel",
        "title": "运行中的命令",
        "url": "index.html#/tray",
        "width": 400,
        "height": 480,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
